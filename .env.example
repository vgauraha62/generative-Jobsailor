# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: spent only when Gemini quota exhausts mid-run (spillover)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
WEB_UI_USER=
# Generate the next two with: venv/bin/python scripts/generate_password_hash.py
WEB_UI_PASSWORD_HASH=
WEB_UI_SECRET_KEY=
